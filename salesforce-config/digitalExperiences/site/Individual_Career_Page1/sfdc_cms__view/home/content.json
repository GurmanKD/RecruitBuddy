            "sectionConfig" : "{\"UUID\":\"18b83489-6348-43c7-b832-3b5846f9b3e5\",\"columns\":[{\"UUID\":\"ac94c7bd-2094-4079-b000-c7ccbce5f521\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"12\",\"seedComponents\":null}]}",
